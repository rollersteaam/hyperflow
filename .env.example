# Google Cloud Console > APIs & Services > Credentials
# OAuth 2.0 Client ID (Web application). Add your dev/prod URLs to
# "Authorized JavaScript origins" (no path, no trailing slash).
VITE_GOOGLE_CLIENT_ID=

# Google Cloud Console > APIs & Services > Credentials > API key
# Restrict it to the Google Calendar API.
VITE_GOOGLE_API_KEY=
